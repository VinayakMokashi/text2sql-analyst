# Copy this file to .env and fill in what you need. .env is git-ignored.

# --- LLM provider ------------------------------------------------------------
# One of: groq | cerebras | openrouter | ollama | openai_compatible | fake
T2S_LLM_PROVIDER=groq

# API key. You can either set it here, or set the provider's usual variable
# (GROQ_API_KEY, CEREBRAS_API_KEY, OPENROUTER_API_KEY).
GROQ_API_KEY=
# T2S_LLM_API_KEY=

# Only needed for T2S_LLM_PROVIDER=openai_compatible (any OpenAI-style endpoint).
# T2S_LLM_BASE_URL=http://localhost:8000/v1

# --- Models --------------------------------------------------------------------
# SQL generation (and SQL repair) uses the "sql" model; table descriptions,
# table selection, follow-up rewriting and the final analysis use the
# cheaper/faster "helper" model.
T2S_SQL_MODEL=openai/gpt-oss-120b
T2S_HELPER_MODEL=qwen/qwen3.8-27b

# Optional, for reasoning models (gpt-oss, Qwen3): low | medium | high.
# Leave unset to use the model's default.
# T2S_SQL_REASONING_EFFORT=medium
# T2S_HELPER_REASONING_EFFORT=

# Examples for other providers:
#   ollama:     T2S_SQL_MODEL=qwen2.5-coder:7b     T2S_HELPER_MODEL=qwen2.5-coder:7b
#   cerebras:   T2S_SQL_MODEL=gpt-oss-120b         T2S_HELPER_MODEL=qwen-3-32b
#   openrouter: T2S_SQL_MODEL=qwen/qwen-2.5-coder-32b-instruct:free

# --- Data ----------------------------------------------------------------------
T2S_DB_PATH=data/chinook.db
T2S_INDEX_DIR=data/index

# --- Pipeline knobs --------------------------------------------------------------
# T2S_TOP_N_TABLES=6        # candidates from vector search
# T2S_TOP_K_TABLES=6        # tables kept after LLM selection
# T2S_MAX_ROWS=200          # rows returned to the user
# T2S_QUERY_TIMEOUT_S=10    # SQL execution timeout
# T2S_MAX_RETRIES=2         # SQL self-correction retries
# T2S_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Public demo (leave unset for unlimited use) ---------------------------------
# T2S_DEMO_DAILY_LIMIT=40   # questions per day, shared by all visitors
# T2S_DEMO_SESSION_LIMIT=10 # questions per visit
