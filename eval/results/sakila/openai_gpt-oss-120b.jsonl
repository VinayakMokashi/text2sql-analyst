{"model": "openai/gpt-oss-120b", "provider": "groq", "helper_model": "qwen/qwen3.8-27b", "questions_file": "sakila_questions.jsonl", "id": "s05", "difficulty": "medium", "question": "Which actor has appeared in the most films?", "answerable": true, "correct": true, "status": "ok", "message": "", "error_kind": null, "llm_error": false, "sql": "SELECT \n    a.first_name,\n    a.last_name,\n    COUNT(fa.film_id) AS film_count\nFROM actor AS a\nJOIN film_actor AS fa\n    ON fa.actor_id = a.actor_id\nGROUP BY a.actor_id, a.first_name, a.last_name\nORDER BY film_count DESC\nLIMIT 1", "attempts": 1, "repaired": false, "latency_s": 1.231, "sql_latency_s": 0.889, "candidates": ["film_actor", "actor", "film_category", "film", "inventory", "country"], "selection_tables": ["actor", "film_actor"], "selection_answerable": true, "tables_used": ["actor", "film_actor"], "recall_at_n": 1.0, "schema_recall": 1.0}
