{"model": "openai/gpt-oss-120b", "provider": "groq", "helper_model": "qwen/qwen3.8-27b", "questions_file": "sakila_questions.jsonl", "id": "s07", "difficulty": "medium", "question": "Which film category has the most films?", "answerable": true, "correct": true, "status": "ok", "message": "", "error_kind": null, "llm_error": false, "sql": "SELECT \n    c.name AS category_name,\n    COUNT(fc.film_id) AS film_count\nFROM film_category fc\nJOIN category c ON fc.category_id = c.category_id\nGROUP BY c.category_id, c.name\nORDER BY film_count DESC\nLIMIT 1", "attempts": 1, "repaired": false, "latency_s": 1.935, "sql_latency_s": 1.648, "candidates": ["film_category", "film", "inventory", "film_actor", "category", "actor"], "selection_tables": ["film_category", "category"], "selection_answerable": true, "tables_used": ["film_category", "category"], "recall_at_n": 1.0, "schema_recall": 1.0}
{"model": "openai/gpt-oss-120b", "provider": "groq", "helper_model": "qwen/qwen3.8-27b", "questions_file": "sakila_questions.jsonl", "id": "s08", "difficulty": "medium", "question": "Which customer has made the most rentals?", "answerable": true, "correct": true, "status": "ok", "message": "", "error_kind": null, "llm_error": false, "sql": "SELECT \n    c.customer_id,\n    c.first_name || ' ' || c.last_name AS customer_name,\n    COUNT(r.rental_id) AS rental_count\nFROM rental r\nJOIN customer c ON r.customer_id = c.customer_id\nGROUP BY c.customer_id\nORDER BY rental_count DESC\nLIMIT 1", "attempts": 1, "repaired": false, "latency_s": 1.309, "sql_latency_s": 0.935, "candidates": ["rental", "payment", "customer", "store", "film", "inventory"], "selection_tables": ["rental", "customer"], "selection_answerable": true, "tables_used": ["rental", "customer"], "recall_at_n": 1.0, "schema_recall": 1.0}
{"model": "openai/gpt-oss-120b", "provider": "groq", "helper_model": "qwen/qwen3.8-27b", "questions_file": "sakila_questions.jsonl", "id": "s09", "difficulty": "medium", "question": "Which customer has spent the most money?", "answerable": true, "correct": true, "status": "ok", "message": "", "error_kind": null, "llm_error": false, "sql": "SELECT \n    c.customer_id,\n    c.first_name || ' ' || c.last_name AS customer_name,\n    c.email,\n    ROUND(SUM(p.amount), 2) AS total_spent\nFROM payment p\nJOIN customer c ON p.customer_id = c.customer_id\nGROUP BY c.customer_id\nORDER BY total_spent DESC\nLIMIT 1", "attempts": 1, "repaired": false, "latency_s": 1.466, "sql_latency_s": 0.899, "candidates": ["payment", "customer", "rental", "store", "staff", "category"], "selection_tables": ["payment", "customer"], "selection_answerable": true, "tables_used": ["payment", "customer"], "recall_at_n": 1.0, "schema_recall": 1.0}
{"model": "openai/gpt-oss-120b", "provider": "groq", "helper_model": "qwen/qwen3.8-27b", "questions_file": "sakila_questions.jsonl", "id": "s10", "difficulty": "medium", "question": "What was the total payment amount in July 2005?", "answerable": true, "correct": true, "status": "ok", "message": "", "error_kind": null, "llm_error": false, "sql": "SELECT ROUND(SUM(amount), 2) AS total_payment_july_2005\nFROM payment\nWHERE strftime('%Y-%m', payment_date) = '2005-07'", "attempts": 1, "repaired": false, "latency_s": 1.124, "sql_latency_s": 0.772, "candidates": ["payment", "rental", "film", "customer", "city", "country"], "selection_tables": ["payment"], "selection_answerable": true, "tables_used": ["payment"], "recall_at_n": 1.0, "schema_recall": 1.0}
{"model": "openai/gpt-oss-120b", "provider": "groq", "helper_model": "qwen/qwen3.8-27b", "questions_file": "sakila_questions.jsonl", "id": "s11", "difficulty": "hard", "question": "Which film category generates the most rental revenue?", "answerable": true, "correct": true, "status": "ok", "message": "", "error_kind": null, "llm_error": false, "sql": "SELECT \n    c.name AS category,\n    ROUND(SUM(p.amount), 2) AS total_revenue\nFROM payment p\nJOIN rental r ON p.rental_id = r.rental_id\nJOIN inventory i ON r.inventory_id = i.inventory_id\nJOIN film f ON i.film_id = f.film_id\nJOIN film_category fc ON f.film_id = fc.film_id\nJOIN category c ON fc.category_id = c.category_id\nGROUP BY c.category_id, c.name\nORDER BY total_revenue DESC\nLIMIT 1", "attempts": 1, "repaired": false, "latency_s": 38.109, "sql_latency_s": 3.433, "candidates": ["film", "film_category", "rental", "inventory", "payment", "film_actor"], "selection_tables": ["film_category", "category", "film", "inventory", "rental", "payment"], "selection_answerable": true, "tables_used": ["film_category", "category", "film", "inventory", "rental", "payment"], "recall_at_n": 0.8, "schema_recall": 1.0}
{"model": "openai/gpt-oss-120b", "provider": "groq", "helper_model": "qwen/qwen3.8-27b", "questions_file": "sakila_questions.jsonl", "id": "s12", "difficulty": "hard", "question": "Which country has the most customers?", "answerable": true, "correct": true, "status": "ok", "message": "", "error_kind": null, "llm_error": false, "sql": "SELECT \n    country.country AS country,\n    COUNT(customer.customer_id) AS customer_count\nFROM customer\nJOIN address   ON customer.address_id = address.address_id\nJOIN city      ON address.city_id   = city.city_id\nJOIN country   ON city.country_id   = country.country_id\nGROUP BY country.country\nORDER BY customer_count DESC\nLIMIT 1", "attempts": 1, "repaired": false, "latency_s": 1.432, "sql_latency_s": 0.853, "candidates": ["customer", "country", "payment", "city", "rental", "store"], "selection_tables": ["customer", "address", "city", "country"], "selection_answerable": true, "tables_used": ["customer", "address", "city", "country"], "recall_at_n": 0.75, "schema_recall": 1.0}
{"model": "openai/gpt-oss-120b", "provider": "groq", "helper_model": "qwen/qwen3.8-27b", "questions_file": "sakila_questions.jsonl", "id": "s13", "difficulty": "hard", "question": "How many films have never been rented?", "answerable": true, "correct": true, "status": "ok", "message": "", "error_kind": null, "llm_error": false, "sql": "SELECT COUNT(*) AS never_rented_films\nFROM film f\nWHERE NOT EXISTS (\n    SELECT 1\n    FROM inventory i\n    JOIN rental r ON r.inventory_id = i.inventory_id\n    WHERE i.film_id = f.film_id\n)", "attempts": 1, "repaired": false, "latency_s": 2.317, "sql_latency_s": 1.96, "candidates": ["film", "rental", "film_category", "inventory", "film_actor", "payment"], "selection_tables": ["film", "inventory", "rental"], "selection_answerable": true, "tables_used": ["film", "inventory", "rental"], "recall_at_n": 1.0, "schema_recall": 1.0}
