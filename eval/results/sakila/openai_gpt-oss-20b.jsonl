{"model": "openai/gpt-oss-20b", "provider": "groq", "helper_model": "qwen/qwen3.8-27b", "questions_file": "sakila_questions.jsonl", "id": "s07", "difficulty": "medium", "question": "Which film category has the most films?", "answerable": true, "correct": true, "status": "ok", "message": "", "error_kind": null, "llm_error": false, "sql": "SELECT\n    category.name AS category_name,\n    COUNT(film_category.film_id) AS film_count\nFROM\n    film_category\nJOIN\n    category\n    ON film_category.category_id = category.category_id\nGROUP BY\n    category.category_id,\n    category.name\nORDER BY\n    film_count DESC\nLIMIT 1", "attempts": 1, "repaired": false, "latency_s": 1.354, "sql_latency_s": 1.311, "candidates": ["film_category", "film", "inventory", "film_actor", "category", "actor"], "selection_tables": ["film_category", "category"], "selection_answerable": true, "tables_used": ["film_category", "category"], "recall_at_n": 1.0, "schema_recall": 1.0}
{"model": "openai/gpt-oss-20b", "provider": "groq", "helper_model": "qwen/qwen3.8-27b", "questions_file": "sakila_questions.jsonl", "id": "s08", "difficulty": "medium", "question": "Which customer has made the most rentals?", "answerable": true, "correct": true, "status": "ok", "message": "", "error_kind": null, "llm_error": false, "sql": "SELECT\n    c.first_name || ' ' || c.last_name AS customer_name,\n    COUNT(r.rental_id) AS total_rentals\nFROM\n    rental r\nJOIN\n    customer c\n    ON r.customer_id = c.customer_id\nGROUP BY\n    c.customer_id, c.first_name, c.last_name\nORDER BY\n    total_rentals DESC\nLIMIT 1", "attempts": 1, "repaired": false, "latency_s": 0.537, "sql_latency_s": 0.511, "candidates": ["rental", "payment", "customer", "store", "film", "inventory"], "selection_tables": ["rental", "customer"], "selection_answerable": true, "tables_used": ["rental", "customer"], "recall_at_n": 1.0, "schema_recall": 1.0}
{"model": "openai/gpt-oss-20b", "provider": "groq", "helper_model": "qwen/qwen3.8-27b", "questions_file": "sakila_questions.jsonl", "id": "s09", "difficulty": "medium", "question": "Which customer has spent the most money?", "answerable": true, "correct": true, "status": "ok", "message": "", "error_kind": null, "llm_error": false, "sql": "SELECT\n    c.first_name,\n    c.last_name,\n    ROUND(SUM(p.amount), 2) AS total_spent\nFROM payment p\nJOIN customer c ON p.customer_id = c.customer_id\nGROUP BY c.customer_id, c.first_name, c.last_name\nORDER BY total_spent DESC\nLIMIT 1", "attempts": 1, "repaired": false, "latency_s": 0.743, "sql_latency_s": 0.664, "candidates": ["payment", "customer", "rental", "store", "staff", "category"], "selection_tables": ["payment", "customer"], "selection_answerable": true, "tables_used": ["payment", "customer"], "recall_at_n": 1.0, "schema_recall": 1.0}
{"model": "openai/gpt-oss-20b", "provider": "groq", "helper_model": "qwen/qwen3.8-27b", "questions_file": "sakila_questions.jsonl", "id": "s10", "difficulty": "medium", "question": "What was the total payment amount in July 2005?", "answerable": true, "correct": true, "status": "ok", "message": "", "error_kind": null, "llm_error": false, "sql": "SELECT ROUND(SUM(amount), 2) AS total_payment_amount\nFROM payment\nWHERE strftime('%Y-%m', payment_date) = '2005-07'", "attempts": 1, "repaired": false, "latency_s": 0.64, "sql_latency_s": 0.566, "candidates": ["payment", "rental", "film", "customer", "city", "country"], "selection_tables": ["payment"], "selection_answerable": true, "tables_used": ["payment"], "recall_at_n": 1.0, "schema_recall": 1.0}
{"model": "openai/gpt-oss-20b", "provider": "groq", "helper_model": "qwen/qwen3.8-27b", "questions_file": "sakila_questions.jsonl", "id": "s11", "difficulty": "hard", "question": "Which film category generates the most rental revenue?", "answerable": true, "correct": true, "status": "ok", "message": "", "error_kind": null, "llm_error": false, "sql": "SELECT\n    c.name AS category_name,\n    ROUND(SUM(p.amount), 2) AS total_revenue\nFROM payment p\nJOIN rental r ON p.rental_id = r.rental_id\nJOIN inventory i ON r.inventory_id = i.inventory_id\nJOIN film f ON i.film_id = f.film_id\nJOIN film_category fc ON f.film_id = fc.film_id\nJOIN category c ON fc.category_id = c.category_id\nGROUP BY c.category_id, c.name\nORDER BY total_revenue DESC\nLIMIT 1", "attempts": 1, "repaired": false, "latency_s": 9.495, "sql_latency_s": 1.121, "candidates": ["film", "film_category", "rental", "inventory", "payment", "film_actor"], "selection_tables": ["film_category", "category", "film", "inventory", "rental", "payment"], "selection_answerable": true, "tables_used": ["film_category", "category", "film", "inventory", "rental", "payment"], "recall_at_n": 0.8, "schema_recall": 1.0}
{"model": "openai/gpt-oss-20b", "provider": "groq", "helper_model": "qwen/qwen3.8-27b", "questions_file": "sakila_questions.jsonl", "id": "s12", "difficulty": "hard", "question": "Which country has the most customers?", "answerable": true, "correct": true, "status": "ok", "message": "", "error_kind": null, "llm_error": false, "sql": "SELECT\n    country.country AS country_name,\n    COUNT(customer.customer_id) AS total_customers\nFROM\n    customer\nJOIN address ON customer.address_id = address.address_id\nJOIN city ON address.city_id = city.city_id\nJOIN country ON city.country_id = country.country_id\nGROUP BY\n    country.country\nORDER BY\n    total_customers DESC\nLIMIT 1", "attempts": 1, "repaired": false, "latency_s": 11.232, "sql_latency_s": 0.979, "candidates": ["customer", "country", "payment", "city", "rental", "store"], "selection_tables": ["customer", "address", "city", "country"], "selection_answerable": true, "tables_used": ["customer", "address", "city", "country"], "recall_at_n": 0.75, "schema_recall": 1.0}
{"model": "openai/gpt-oss-20b", "provider": "groq", "helper_model": "qwen/qwen3.8-27b", "questions_file": "sakila_questions.jsonl", "id": "s13", "difficulty": "hard", "question": "How many films have never been rented?", "answerable": true, "correct": true, "status": "ok", "message": "", "error_kind": null, "llm_error": false, "sql": "SELECT COUNT(*) AS films_never_rented\nFROM film f\nWHERE NOT EXISTS (\n    SELECT 1\n    FROM rental r\n    JOIN inventory i ON r.inventory_id = i.inventory_id\n    WHERE i.film_id = f.film_id\n)", "attempts": 1, "repaired": false, "latency_s": 10.341, "sql_latency_s": 1.142, "candidates": ["film", "rental", "film_category", "inventory", "film_actor", "payment"], "selection_tables": ["film", "inventory", "rental"], "selection_answerable": true, "tables_used": ["film", "inventory", "rental"], "recall_at_n": 1.0, "schema_recall": 1.0}
