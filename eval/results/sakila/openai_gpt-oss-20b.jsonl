{"model": "openai/gpt-oss-20b", "provider": "groq", "helper_model": "qwen/qwen3.8-27b", "questions_file": "sakila_questions.jsonl", "id": "s05", "difficulty": "medium", "question": "Which actor has appeared in the most films?", "answerable": true, "correct": true, "status": "ok", "message": "", "error_kind": null, "llm_error": false, "sql": "WITH film_counts AS (\n    SELECT\n        a.actor_id,\n        a.first_name,\n        a.last_name,\n        COUNT(fa.film_id) AS total_films\n    FROM actor a\n    JOIN film_actor fa ON a.actor_id = fa.actor_id\n    GROUP BY a.actor_id, a.first_name, a.last_name\n)\nSELECT\n    a.first_name || ' ' || a.last_name AS actor_name,\n    fc.total_films\nFROM film_counts fc\nJOIN actor a ON a.actor_id = fc.actor_id\nORDER BY fc.total_films DESC\nLIMIT 1", "attempts": 1, "repaired": false, "latency_s": 0.942, "sql_latency_s": 0.9, "candidates": ["film_actor", "actor", "film_category", "film", "inventory", "country"], "selection_tables": ["actor", "film_actor"], "selection_answerable": true, "tables_used": ["actor", "film_actor"], "recall_at_n": 1.0, "schema_recall": 1.0}
