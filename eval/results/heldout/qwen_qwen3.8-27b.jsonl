{"model": "qwen/qwen3.8-27b", "provider": "groq", "helper_model": "qwen/qwen3.8-27b", "questions_file": "heldout.jsonl", "id": "t17", "difficulty": "hard", "question": "Which album has generated the most revenue?", "answerable": true, "correct": true, "status": "ok", "message": "", "error_kind": null, "llm_error": false, "sql": "SELECT \n    a.Title AS AlbumTitle,\n    ROUND(SUM(il.UnitPrice * il.Quantity), 2) AS TotalRevenue\nFROM Album a\nJOIN Track t ON a.AlbumId = t.AlbumId\nJOIN InvoiceLine il ON t.TrackId = il.TrackId\nGROUP BY a.AlbumId, a.Title\nORDER BY TotalRevenue DESC\nLIMIT 1", "attempts": 1, "repaired": false, "latency_s": 7.51, "sql_latency_s": 0.456, "candidates": ["Album", "Track", "Artist", "InvoiceLine", "Invoice", "Playlist"], "selection_tables": ["Album", "Track", "InvoiceLine"], "selection_answerable": true, "tables_used": ["Album", "Track", "InvoiceLine"], "recall_at_n": 1.0, "schema_recall": 1.0}
