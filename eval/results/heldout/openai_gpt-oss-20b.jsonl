{"model": "openai/gpt-oss-20b", "provider": "groq", "helper_model": "qwen/qwen3.8-27b", "questions_file": "heldout.jsonl", "id": "t14", "difficulty": "hard", "question": "Customers from which country bought the most Rock tracks?", "answerable": true, "correct": true, "status": "ok", "message": "", "error_kind": null, "llm_error": false, "sql": "WITH rock_sales AS (\n    SELECT\n        c.Country AS country,\n        SUM(il.Quantity) AS rock_tracks\n    FROM InvoiceLine il\n    JOIN Invoice i ON il.InvoiceId = i.InvoiceId\n    JOIN Customer c ON i.CustomerId = c.CustomerId\n    JOIN Track t ON il.TrackId = t.TrackId\n    JOIN Genre g ON t.GenreId = g.GenreId\n    WHERE g.Name = 'Rock'\n    GROUP BY c.Country\n)\nSELECT\n    country,\n    rock_tracks\nFROM rock_sales\nORDER BY rock_tracks DESC\nLIMIT 1", "attempts": 1, "repaired": false, "latency_s": 11.336, "sql_latency_s": 1.247, "candidates": ["InvoiceLine", "Track", "Album", "PlaylistTrack", "Artist", "Customer"], "selection_tables": ["InvoiceLine", "Track", "Genre", "Invoice", "Customer"], "selection_answerable": true, "tables_used": ["InvoiceLine", "Track", "Genre", "Invoice", "Customer"], "recall_at_n": 0.6, "schema_recall": 1.0}
