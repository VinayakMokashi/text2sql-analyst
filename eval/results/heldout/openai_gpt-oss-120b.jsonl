{"model": "openai/gpt-oss-120b", "provider": "groq", "helper_model": "qwen/qwen3.8-27b", "questions_file": "heldout.jsonl", "id": "t14", "difficulty": "hard", "question": "Customers from which country bought the most Rock tracks?", "answerable": true, "correct": true, "status": "ok", "message": "", "error_kind": null, "llm_error": false, "sql": "SELECT \n    c.Country AS Country,\n    SUM(il.Quantity) AS Rock_Tracks_Purchased\nFROM InvoiceLine il\nJOIN Track t          ON il.TrackId = t.TrackId\nJOIN Genre g          ON t.GenreId = g.GenreId\nJOIN Invoice inv      ON il.InvoiceId = inv.InvoiceId\nJOIN Customer c       ON inv.CustomerId = c.CustomerId\nWHERE g.Name = 'Rock'\nGROUP BY c.Country\nORDER BY Rock_Tracks_Purchased DESC\nLIMIT 1", "attempts": 1, "repaired": false, "latency_s": 6.429, "sql_latency_s": 2.107, "candidates": ["InvoiceLine", "Track", "Album", "PlaylistTrack", "Artist", "Customer"], "selection_tables": ["InvoiceLine", "Track", "Genre", "Invoice", "Customer"], "selection_answerable": true, "tables_used": ["InvoiceLine", "Track", "Genre", "Invoice", "Customer"], "recall_at_n": 0.6, "schema_recall": 1.0}
