{"model": "openai/gpt-oss-20b", "provider": "groq", "helper_model": "qwen/qwen3.8-27b", "questions_file": "questions.jsonl", "id": "h01", "difficulty": "hard", "question": "Which 5 genres generate the most revenue?", "answerable": true, "correct": true, "status": "ok", "message": "", "error_kind": null, "llm_error": false, "sql": "SELECT\n    g.Name AS genre,\n    ROUND(SUM(il.UnitPrice * il.Quantity), 2) AS total_revenue\nFROM\n    InvoiceLine il\nJOIN\n    Track t ON il.TrackId = t.TrackId\nJOIN\n    Genre g ON t.GenreId = g.GenreId\nGROUP BY\n    g.GenreId, g.Name\nORDER BY\n    total_revenue DESC\nLIMIT 5", "attempts": 1, "repaired": false, "latency_s": 7.001, "sql_latency_s": 1.943, "candidates": ["Genre", "Track", "InvoiceLine", "Artist", "Invoice", "Album"], "selection_tables": ["Genre", "Track", "InvoiceLine"], "selection_answerable": true, "tables_used": ["Genre", "Track", "InvoiceLine"], "recall_at_n": 1.0, "schema_recall": 1.0}
