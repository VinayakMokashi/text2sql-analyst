{"model": "openai/gpt-oss-120b", "provider": "groq", "helper_model": "qwen/qwen3.8-27b", "questions_file": "questions.jsonl", "id": "h01", "difficulty": "hard", "question": "Which 5 genres generate the most revenue?", "answerable": true, "correct": true, "status": "ok", "message": "", "error_kind": null, "llm_error": false, "sql": "WITH genre_revenue AS (\n    SELECT \n        g.Name AS Genre,\n        ROUND(SUM(il.UnitPrice * il.Quantity), 2) AS total_revenue\n    FROM InvoiceLine il\n    JOIN Track t      ON il.TrackId = t.TrackId\n    JOIN Genre g      ON t.GenreId = g.GenreId\n    GROUP BY g.GenreId, g.Name\n)\nSELECT \n    Genre,\n    total_revenue\nFROM genre_revenue\nORDER BY total_revenue DESC\nLIMIT 5", "attempts": 1, "repaired": false, "latency_s": 6.469, "sql_latency_s": 1.1, "candidates": ["Genre", "Track", "InvoiceLine", "Artist", "Invoice", "Album"], "selection_tables": ["Genre", "Track", "InvoiceLine"], "selection_answerable": true, "tables_used": ["Genre", "Track", "InvoiceLine"], "recall_at_n": 1.0, "schema_recall": 1.0}
